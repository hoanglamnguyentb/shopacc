<div id="collapseDiv" class="panel-collapse collapse" aria-expanded="false" role="tabpanel">
    <div class="well SearchBox">

        @using (Ajax.BeginForm("searchData", "MaGiamGia", new { Area = "MaGiamGiaArea" },
            new AjaxOptions()
            {
                HttpMethod = "POST",
                OnFailure = "AjaxFormError",
                OnSuccess = "AjaxSearchSuccess",
            }, new { }))
        {
            @Html.AntiForgeryToken()
        <div class="row row-block">
		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Số lượng</div>
			<div class="col-md-8">
				<input type="number" class="form-control width100" name="SoLuongFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Từ ngày</div>
			<div class="col-md-8">
				<input type="text" class="form-control width100" name="TuNgayFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Đến ngày</div>
			<div class="col-md-8">
				<input type="text" class="form-control width100" name="DenNgayFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Áp dụng toàn hệ thống</div>
			<div class="col-md-8">
				<input type="checkbox" value="true" name="ToanHeThongFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Trạng thái</div>
			<div class="col-md-8">
				@*@Html.DropDownList("TrangThaiFilter",ViewBag.dropdownListTrangThai as List<SelectListItem>, new { @class="form-control"})*@
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Thông tin</div>
			<div class="col-md-8">
				<input class="form-control width100" type="text" name="ThongTinFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Gian hàng áp dụng</div>
			<div class="col-md-8">
				<input class="form-control width100" type="text" name="GianHangApDungFilter" />
			</div>
		</div>


            <div class="col-md-12 center" style=" margin-top:20px;">
                <button id="btnSearch" type="submit" class="btn btn-labeled btn-primary btn-sm">
                    <span class="btn-label">
                        <i class="glyphicon glyphicon-search"></i>
                    </span>
                    Tìm kiếm
                </button>

                <a aria-expanded="false" href="#collapseDiv" data-toggle="collapse" role="button" class="btn btn-labeled btn-danger btn-sm">
                    <span class="btn-label"><i class="glyphicon glyphicon-remove"></i></span>
                    Đóng
                </a>
            </div>
        </div>

        }
    </div>
</div>


