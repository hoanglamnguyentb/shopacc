@using Hinet.Model.IdentityEntities
@using Hinet.Model.Entities
@using Hinet.Web.Areas.MaGiamGiaArea.Models

@model CreateVM
@{
    var dropdownListTrangThai = ViewBag.dropdownListTrangThai as List<SelectListItem>;
    var dropdownListGianHangId = ViewBag.dropdownListGianHangId as List<SelectListItem>;
}

<div class="modal-dialog">
    @using (Ajax.BeginForm("Create", "MaGiamGia", new { @area = "MaGiamGiaArea" }, new AjaxOptions()
    {
        HttpMethod = "POST",
        OnFailure = "AjaxFormError",
        OnSuccess = "AjaxFormSuccess",
    }, new { id = "createMaGiamGiaForm" }))
    {
        @Html.AntiForgeryToken()
        //HtmlHelper.UnobtrusiveJavaScriptEnabled = false;
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <div class="center">
                    <h4 class="modal-title">Tạo mới </h4>
                </div>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-sm-4">Số lượng </label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => m.SoLuong, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.SoLuong, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-sm-4">Từ ngày </label>
                        <div class="col-sm-8">
                            @Html.DatePickerFor(m => m.TuNgay, "autoclose=true", "todayBtn=true", "todayHighlight=true")
                            @Html.ValidationMessageFor(m => m.TuNgay, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-sm-4">Đến ngày </label>
                        <div class="col-sm-8">
                            @Html.DatePickerFor(m => m.DenNgay, "autoclose=true", "todayBtn=true", "todayHighlight=true")
                            @Html.ValidationMessageFor(m => m.DenNgay, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-sm-4">Áp dụng toàn hệ thống</label>
                        <div class="col-sm-8">
                            <label class="switch">
                                <input type="checkbox" checked value="true" id="ToanHeThong" name="ToanHeThong">
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-sm-4">Kích hoạt </label>
                        <div class="col-sm-8">
                            <label class="switch">
                                <input type="checkbox" checked value="true" id="KichHoat" name="KichHoat">
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-sm-4">Thông tin </label>
                        <div class="col-sm-8">
                            @Html.TextAreaFor(m => m.ThongTin, 4, 3, new { @class = "form-control resize-vertical" })
                            @Html.ValidationMessageFor(m => m.ThongTin, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-sm-4">Gian hàng áp dụng </label>
                        <div class="col-sm-8 w-full-select2">
                            @Html.ListBoxFor(m => m.GianHangApDung, dropdownListGianHangId, new { @class = "form-control", multiple = "multiple" })
                            @Html.ValidationMessageFor(m => m.GianHangApDung, "", new { @class = "text-danger" })
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer center">
                <button type="submit" class="btn btn-primary">Hoàn thành</button>

                <button type="button" class="btn btn-default" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    }
</div>

<script>
    $("#GianHangApDung").select2({
        placeholder: "--Chọn gian hàng--",
        allowClear: true
    });
</script>
@Scripts.Render("~/bundles/jqueryval")
