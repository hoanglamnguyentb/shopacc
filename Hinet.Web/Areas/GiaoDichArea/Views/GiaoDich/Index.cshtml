@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/_LayoutAce.cshtml";
    ViewBag.ModuleName = "Quản lý ";
    ViewBag.PageName = "Danh sách ";
    ViewBag.ModuleCode = "GiaoDich_index";

}
@using Hinet.Model.IdentityEntities;
@using Hinet.Model.Entities;
@using Newtonsoft.Json;
@using Hinet.Service.Common;
@using Hinet.Service.GiaoDichService.Dto;
@using Hinet.Service.Constant;
@model PageListResultBO<GiaoDichDto>
@{
    var loaiGiaoDich = ViewBag.loaiGiaoDich as string;
    var lstData = Html.Raw(JsonConvert.SerializeObject(Model.ListItem));
    var dropdownListLoaiGiaoDich = ViewBag.dropdownListLoaiGiaoDich as List<SelectListItem>;
}

@section ActionBarRight{
    <a href="#collapseDiv" class="btn btn-sm btn-primary" aria-controls="collapsePanel" data-toggle="collapse" role="button">
        <i class="bi bi-search"></i> Tìm kiếm
    </a>
    <a href="javascript:void(0)" onclick="CreateAction('/GiaoDichArea/GiaoDich/Create')" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Thêm mới</a>
}
@Html.Partial("_SearchPartial")

<div class="tabbable">
    <ul class="nav nav-tabs">
        <li class="nav-item @(string.IsNullOrEmpty(loaiGiaoDich) ? "active" : "")">
            <a class="nav-link" href="/GiaoDichArea/GiaoDich">Tất cả</a>
        </li>
        @foreach (var item in dropdownListLoaiGiaoDich)
        {
            <li class="nav-item @(!string.IsNullOrEmpty(loaiGiaoDich) && loaiGiaoDich == item.Value ? "active" : "")">
                <a class="nav-link" href="/GiaoDichArea/GiaoDich?loaiGiaoDich=@item.Value">@item.Text</a>
            </li>
        }
    </ul>
    <div class="tab-content">
        <div id="tbl-GiaoDich" class="hntbl-cover table-scroll">
            <div class="table-wrap">
                <table class="hinet-table table table-striped table-hover" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th class="fixed-side">#</th>
                            <th class="fixed-side">Thao tác</th>
                            <th>Người giao dịch</th>
                            <th>Đối tượng <br /> Loại đối tượng</th>
                            <th>Loại giao dịch</th>
                            <th>Trạng thái</th>
                            <th>Phương thức thanh toán </th>
                            <th>Ngày giao dịch <br /> Ngày thanh toán</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        var lstData = eval(@lstData);
        var moduleTableSelector="#tbl-GiaoDich";
        function pagefunction(){
            var conf=[
                {
                    tdClass:"center width50 fixed-side",
                    isSort:false,
                    nameModel: "",
                    isCounter:true,
                    content: function (data) {
                        return "<input type='checkbox'/>"
                    }
                },
                   {
                       isSort:false,
                       nameModel:"",
                       tdClass:"center fixed-side",
                       content: function (data) {
                           var result = `<div class="btn-group">
                               <button data-toggle="dropdown" class="btn btn-xs btn-primary btn-white dropdown-toggle" aria-expanded="false">Thao tác<i class="ace-icon fa fa-angle-down icon-on-right"></i>
                               </button>

                               <ul class="dropdown-menu">`;
                           result += "<li><a href='javascript:void(0)' onclick='DetailAction(\"/GiaoDichArea/GiaoDich/Detail/" + data.Id + "\")'   title = 'Chi tiết giao dịch'><i class='bi bi-eye'> </i> Chi tiết</a> </li>";
                           if (data.LoaiGiaoDich == '@LoaiGiaoDichConstant.NAPTOPUP') {
                               result += "<li><a href='javascript:void(0)' onclick='EditAction(\"/GiaoDichArea/GiaoDich/XuLy/" + data.Id + "\")'   title = 'Xử lý giao dịch'><i class='bi bi-pencil-square'> </i> Xử lý giao dịch</a> </li>";
                           }
                           result += "</ul></div>";
                           return result;
                       }
                   },
				{
					isSort:true,
					nameModel:'UserId',
                    content: function (data) {
                        return `<div>${data.NguoiGiaoDichTxt} #${data.NguoiGiaoDich}</div>`
				}
				},
				{
					isSort:true,
					nameModel:'DoiTuongId',
					content: function (data) {
                        return `#${data.TaiKhoanTxt} <br /> ${data.LoaiDoiTuongTxt}`
				}
				},
				{
					isSort:true,
					nameModel:'LoaiGiaoDich',
					content: function (data) {
                        return data.LoaiGiaoDichTxt
				}
				},
				{
					isSort:true,
					nameModel:'TrangThai',
					content: function (data) {
                        return data.TrangThaiHTML
				}
				},
				{
					isSort:true,
					nameModel:'PhuongThucThanhToan',
					content: function (data) {
                        return data.PhuongThucThanhToanTxt
				}
				},
				{
					isSort:true,
					nameModel:'NgayGiaoDich',
					content: function (data) {
                        return `${ToDateTime(data.NgayGiaoDich)} <br /> ${ToDateTime(data.NgayXuLy) }`
				}
				},
            ];


            var getdatafunc=function(page,sortQuery,pageSize){
                $.ajax({
                    url: '/GiaoDichArea/GiaoDich/getData',
                    type: 'post',
                    cache: false,
                    data:{"indexPage":page,"sortQuery":sortQuery,"pageSize":pageSize},
                    success: function (data) {
                        $(moduleTableSelector).hinetTable("data",{
                            pageSize:pageSize!=-1?pageSize:data.Count,
                            pageIndex:page,
                            pagecount: data.TotalPage,
                            recordCount: data.Count,
                            listItem: data.ListItem,});
                    },
                    error: function (err) {
                        CommonJS.alert(xhr.responseText);
                    }
                });

            }

            var tblData=$("#tbl-GiaoDich").hinetTable("init",{
                pageSizeList:{size:[20,50,100,-1],label:['20','50','100','Tất cả']},
                pagecount: @Model.TotalPage,
                recordCount: @Model.Count,
                actionToolBar:'<a href=\"#collapseDiv\" aria-controls=\"collapsePanel\" data-toggle=\"collapse\" role=\"button\" class="btn btn-primary btn-xs"><i class="bi bi-search"></i> Tìm kiếm</a>',
                getData:getdatafunc,
                listItem:lstData,
                config:conf
            });

        }

        function AfterSussessActionAjaxform(){
            $(moduleTableSelector).hinetTable("reload");
        }
        function AjaxSearchSuccess(rs) {
            $(moduleTableSelector).hinetTable("data", {
                pageIndex: 1,
                pagecount: rs.TotalPage,
                recordCount: rs.Count,
                listItem: rs.ListItem,
            });
        }
        pagefunction();
    </script>
}