<div id="collapseDiv" class="panel-collapse collapse" aria-expanded="false" role="tabpanel">
    <div class="well SearchBox">

        @using (Ajax.BeginForm("searchData", "DonHang", new { Area = "DonHangArea" },
            new AjaxOptions()
            {
                HttpMethod = "POST",
                OnFailure = "AjaxFormError",
                OnSuccess = "AjaxSearchSuccess",
            }, new { }))
        {
            @Html.AntiForgeryToken()
        <div class="row row-block">
		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Đơn hàng Id</div>
			<div class="col-md-8">
				<input class="form-control width100" type="text" name="DonHangIdFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Vật phẩm Id</div>
			<div class="col-md-8">
				<input class="form-control width100" type="text" name="VatPhamIdFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Mã giảm giá</div>
			<div class="col-md-8">
				<input class="form-control width100" type="text" name="MaGiamGiaFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Giá gốc</div>
			<div class="col-md-8">
				<input type="number" class="form-control width100" name="GiaGocFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Giá khuyễn mãi</div>
			<div class="col-md-8">
				<input type="number" class="form-control width100" name="GiaKhuyenMaiFilter" />
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">Trạng thái</div>
			<div class="col-md-8">
				@Html.DropDownList("TrangThaiFilter",ViewBag.dropdownListTrangThai as List<SelectListItem>, new { @class="form-control"})
			</div>
		</div>

		<div class="col-md-6 row-block">
			<div class="col-md-4 txt-label">QrUrl</div>
			<div class="col-md-8">
				<input class="form-control width100" type="text" name="QrUrlFilter" />
			</div>
		</div>


            <div class="col-md-12 center" style=" margin-top:20px;">
                <button id="btnSearch" type="submit" class="btn btn-labeled btn-primary btn-sm">
                    <span class="btn-label">
                        <i class="glyphicon glyphicon-search"></i>
                    </span>
                    Tìm kiếm
                </button>

                <a aria-expanded="false" href="#collapseDiv" data-toggle="collapse" role="button" class="btn btn-labeled btn-danger btn-sm">
                    <span class="btn-label"><i class="glyphicon glyphicon-remove"></i></span>
                    Đóng
                </a>
            </div>
        </div>

        }
    </div>
</div>


