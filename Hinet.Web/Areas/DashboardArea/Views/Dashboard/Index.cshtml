@using Newtonsoft.Json
@model Hinet.Web.Areas.DashboardArea.Models.DashboardDto

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_LayoutAce.cshtml";
    var jsonData = JsonConvert.SerializeObject(Model);
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="d-flex">
    <div class="col-sm-12 mx-auto p-6">
        <!-- Giao dịch chờ xử lý -->
        <section class="bg-white rounded-2xl p-5 shadow border border-slate-200 mt-6">
            <div class="flex items-center justify-between mb-3">
                <h2 class="font-semibold">Giao dịch chờ xử lý</h2>
                <input id="pendingSearch"
                       class="px-3 py-2 border rounded-xl"
                       placeholder="Tìm theo mã đơn, KH..." />
            </div>
            <div class="overflow-auto">
                <table class="w-full">
                    <thead class="sticky top-0 bg-slate-100">
                        <tr>
                            <th class="p-2">Mã</th>
                            <th class="p-2">Khách</th>
                            <th class="p-2">Tổng</th>
                            <th class="p-2">Trạng thái</th>
                            <th class="p-2">Ngày</th>
                        </tr>
                    </thead>
                    <tbody id="pendingOrdersTbody"></tbody>
                </table>
            </div>
        </section>

        <!-- KPI Cards -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
            <article class="bg-white rounded-2xl p-5 shadow border border-slate-200">
                <p class="text-slate-500">Doanh thu hôm nay</p>
                <p id="kpiRevenue" class="text-2xl font-semibold mt-1">—</p>
            </article>
            <article class="bg-white rounded-2xl p-5 shadow border border-slate-200">
                <p class="text-slate-500">Nạp tiền</p>
                <p id="kpiOrders" class="text-2xl font-semibold mt-1">—</p>
            </article>
            <article class="bg-white rounded-2xl p-5 shadow border border-slate-200">
                <p class="text-slate-500">Mua acc</p>
                <p id="kpiMargin" class="text-2xl font-semibold mt-1">—</p>
            </article>
            <article class="bg-white rounded-2xl p-5 shadow border border-slate-200">
                <p class="text-slate-500">Nạp topup</p>
                <p id="kpiDisputes" class="text-2xl font-semibold mt-1">—</p>
            </article>
        </section>

        <!-- Doanh thu theo tháng -->
        <section class="bg-white rounded-2xl p-5 shadow border border-slate-200 mt-6">
            <div class="flex items-center justify-between mb-3">
                <h2 class="font-semibold">Doanh thu theo tháng</h2>
                <select id="rangeSelect" class="px-3 py-2 border rounded-xl">
                    <option value="6">6 tháng</option>
                    <option value="12" selected>12 tháng</option>
                    <option value="0">Toàn thời gian</option>
                </select>
            </div>
            <canvas id="revenueChart" height="100"></canvas>
        </section>

        <!-- Top bán chạy -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
            <div class="bg-white rounded-2xl p-5 shadow border border-slate-200">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="font-semibold">Top game bán chạy</h2>
                    <select id="topGamesRange"
                            class="px-3 py-2 border rounded-xl">
                        <option value="7">7 ngày</option>
                        <option value="30" selected>30 ngày</option>
                        <option value="90">90 ngày</option>
                        <option value="all">Toàn thời gian</option>
                    </select>
                </div>
                <canvas id="topGamesChart" height="100"></canvas>
            </div>
            <div class="bg-white rounded-2xl p-5 shadow border border-slate-200">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="font-semibold">Top dịch vụ bán chạy</h2>
                    <select id="topGamesRange"
                            class="px-3 py-2 border rounded-xl">
                        <option value="7">7 ngày</option>
                        <option value="30" selected>30 ngày</option>
                        <option value="90">90 ngày</option>
                        <option value="all">Toàn thời gian</option>
                    </select>
                </div>
                <canvas id="topItemsChart" height="100"></canvas>
            </div>
        </section>

        <!-- Giao dịch gần đây -->
        <section class="bg-white rounded-2xl p-5 shadow border border-slate-200 mt-6">
            <div class="flex items-center justify-between mb-3">
                <h2 class="font-semibold">Giao dịch gần đây</h2>
                <input id="orderSearch"
                       placeholder="Tìm theo mã đơn, KH, sản phẩm..." />
            </div>
            <div class="overflow-auto">
                <table class="w-full">
                    <thead class="sticky top-0 bg-slate-100">
                        <tr>
                            <th class="p-2">Mã</th>
                            <th class="p-2">Khách</th>
                            <th class="p-2">Tổng</th>
                            <th class="p-2">Trạng thái</th>
                            <th class="p-2">Ngày</th>
                        </tr>
                    </thead>
                    <tbody id="ordersTbody"></tbody>
                </table>
            </div>
        </section>
    </div>

</div>
<script>
    const dashboardData = @Html.Raw(jsonData);

    const fVND = n => n.toLocaleString('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });

    function renderKPI() {
        const kpi = dashboardData.SummaryData;
        kpiRevenue.textContent = fVND(kpi.RevenueToday);
        kpiOrders.textContent = kpi.OrderCount.toLocaleString('vi-VN');
        kpiMargin.textContent = kpi.MarginPercent + '%';
        kpiDisputes.textContent = kpi.DisputesCount;
    }

    let revenueChart;
    function buildRevenueChart(range = 12) {
        const labels = dashboardData.MonthlyChart.map(x => `${x.Month}/${x.Year}`);
        const revenue = dashboardData.MonthlyChart.map(x => x.Revenue);
        const profit = dashboardData.MonthlyChart.map(x => x.Profit);
        const l = range === 0 ? labels : labels.slice(-range);
        const r = range === 0 ? revenue : revenue.slice(-range);
        const p = range === 0 ? profit : profit.slice(-range);

        revenueChart?.destroy();
        revenueChart = new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: l,
                datasets: [
                    { label: 'Doanh thu', data: r, tension: 0.35 },
                    { label: 'Lợi nhuận', data: p, tension: 0.35 }
                ]
            }
        });
    }

    function buildTopChart(elemId, items) {
        const labels = items.map(x => x.Label);
        const data = items.map(x => x.Value);
        new Chart(document.getElementById(elemId), {
            type: 'bar',
            data: { labels, datasets: [{ label: 'Đã bán', data }] },
            options: { indexAxis: 'y', plugins: { legend: { display: false } } }
        });
    }

    function renderOrders() {
        ordersTbody.innerHTML = '';
        dashboardData.Orders.forEach(o => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="p-2">${o.Id}</td>
                <td class="p-2">${o.Customer}</td>
                <td class="p-2">${fVND(o.Total)}</td>
                <td class="p-2">${o.Status}</td>
                <td class="p-2">${o.Date.split('T')[0]}</td>`;
            ordersTbody.appendChild(tr);
        });
    }

    rangeSelect.addEventListener('change', e => buildRevenueChart(parseInt(e.target.value)));

    function renderPendingOrders() {
        const search = pendingSearch.value.toLowerCase();
        pendingOrdersTbody.innerHTML = '';
        console.log("PendingOrders", dashboardData.PendingOrders);

        dashboardData.PendingOrders
            .filter(o =>
                (o.Id + o.Customer).toLowerCase().includes(search)
            )
            .forEach(o => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                <td class="p-2">${o.Id}</td>
                <td class="p-2">${o.Customer}</td>
                <td class="p-2">${fVND(o.Total)}</td>
                <td class="p-2">${o.Status}</td>
                <td class="p-2">${o.Date.split('T')[0]}</td>`;
                pendingOrdersTbody.appendChild(tr);
            });
    }

    pendingSearch.addEventListener('input', renderPendingOrders);


    renderKPI();
    buildRevenueChart(12);
    buildTopChart('topGamesChart', dashboardData.TopGames);
    buildTopChart('topItemsChart', dashboardData.TopItems);
    renderOrders();
    renderPendingOrders();
</script>
