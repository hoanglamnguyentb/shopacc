@using Newtonsoft.Json
@model Hinet.Web.Areas.DashboardArea.Models.DashboardDto

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_LayoutAce.cshtml";
    var jsonData = JsonConvert.SerializeObject(Model);
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="d-flex">
    <div class="col-sm-12 mx-auto p-6">
        <div id="pending-orders-container">
            @{ Html.RenderAction("PendingOrders", "Dashboard", new { area = "DashboardArea" }); }
        </div>
        @{ Html.RenderAction("KpiCards", "Dashboard", new { area = "DashboardArea" }); }
        <div id="revenue-chart-container">
            @{ Html.RenderAction("RevenueChart", "Dashboard", new { area = "DashboardArea" }); }
        </div>
        <div id="topcharts-container">
            @{ Html.RenderAction("TopCharts", "Dashboard", new { area = "DashboardArea" }); }
        </div>    
    </div>
</div>

<script>
    function loadPendingOrders(page = 1, search = '') {
        $.ajax({
            url: '@Url.Action("PendingOrders", "Dashboard", new { area = "DashboardArea" })',
            type: 'GET',
            data: { page: page, search: search },
            success: function (html) {
                $('#pending-orders-container').html(html);
            },
            error: function () {
                alert('Tải danh sách đang chờ xử lý thất bại!');
            }
        });
    }

    // Gọi lần đầu khi load trang
    $(document).ready(function () {
        //loadPendingOrders();

        // Tìm kiếm theo từ khóa
        $('#pendingSearch').on('keypress', function (e) {
            if (e.key === 'Enter') {
                loadPendingOrders(1, this.value);
            }
        });
    });

    function loadRevenueChart(months = 12) {
        $.ajax({
            url: '@Url.Action("RevenueChart", "Dashboard", new { area = "DashboardArea" })',
            type: 'GET',
            data: { months: months },
            success: function (html) {
                $('#revenue-chart-container').html(html);
            },
            error: function () {
                alert('Tải biểu đồ thất bại!');
            }
        });
    }

    function loadTopCharts(days = 30) {
        $.ajax({
            url: '@Url.Action("TopCharts", "Dashboard", new { area = "DashboardArea" })',
            data: { days: days },
            success: function (html) {
                $('#topcharts-container').html(html);
                // Gắn lại sự kiện cho filter sau khi load
                attachTopChartEvents();
            },
            error: function () {
                alert('Không thể tải Top Charts');
            }
        });
    }

    function attachTopChartEvents() {
        $('.top-filter').off('change').on('change', function () {
            const days = parseInt($(this).val());
            loadTopCharts(days);
        });
    }

    $(document).on('change', '#rangeSelect', function () {
        loadRevenueChart(parseInt(this.value));
    });
</script>
