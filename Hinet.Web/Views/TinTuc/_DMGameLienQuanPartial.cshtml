@model List<Hinet.Model.Entities.DanhMucGame>
@{ 
    var gameSlug = ViewBag.GameSlug;
}


<div class="sub-article-block bg-white shadow-sm">
    <div class="sub-article-block-header d-flex justify-content-between align-items-center c-px-16 c-py-12">
        <h2 class="fw-600 fz-16 lh-16">
            Tài khoản liên quan
        </h2>
        <a href="/game/@gameSlug" class="link arr-right pr-0">Xem tất cả</a>
    </div>
    @foreach (var item in Model)
    {
        <div class="sub-article c-px-16">
            <div class="row">
                <div class="col-6 sub-article--thumbnail-container">
                    <div class="sub-article--thumbnail">
                        <a href="/mua-acc/@item.Slug">
                            <img onerror="imgError(this)" src="@item.DuongDanAnh" data-src="@item.DuongDanAnh" alt="" class="sub-article--thumbnail__image ls-is-cached lazyloaded">
                        </a>
                    </div>
                </div>
                <div class="col-6 sub-article--info">
                    <a href="/mua-acc/@item.Slug" class="sub-article--title__link">
                        @item.Name
                    </a>
                </div>
            </div>
        </div>
    }

</div>