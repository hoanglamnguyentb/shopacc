@using CommonHelper.String;
@model Hinet.Service.TinTucService.Dto.TinTucDto
@{
    var gameSlug = (Model != null && Model.Game != null) ? Model.Game.Slug : null;
}

<div class="container container-fix">
    <ul class="breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
        </li>
        <li class="breadcrumb-item">
            <a href="/tin-tuc" class="breadcrumb-link">Tin tức</a>
        </li>
        <li class="breadcrumb-item">
            <a href="#" class="breadcrumb-link">Chi tiết tin tức</a>
        </li>
    </ul>
    <hr />
    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="--custom p-3 mb-3 content-detail bg-white c-mt-16 border shadow-sm">
                <article id="article--detail">
                    <h1 class="article--title">
                        @Model.TieuDe
                    </h1>
                    <div class="article--info mt-2">
                        <span class="mr-2"><i class="bi bi-alarm"></i> @StringUtilities.ToDateVNFormat(Model.CreatedDate)</span>
                        <span><i class="bi bi-person"></i> @Model.TacGia</span>
                    </div>
                    <div class="py-2">
                        <img src="@Model.AnhBia" alt="" class="article--thumbnail__image py-3 w-100">
                    </div>
                    <div class="article--content pb-3">
                        @Html.Raw(Model.NoiDung)
                    </div>
                </article>
            </div>
        </div>

        <div class="col-lg-4 d-none d-lg-block c-mt-16">
            @Html.Action("DMGameLienQuan", "TinTuc", new { id = Model.Id, gameSlug = gameSlug, area = "" })
            @Html.Action("DichVuLienQuan", "TinTuc", new { id = Model.Id, area = "" })
        </div>
    </div>

    @Html.Action("TinTucLienQuan", "TinTuc", new { id = Model.Id, area = "" })

</div>