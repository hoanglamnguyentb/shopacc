                        <div class="bg-white rounded-lg hover:border-blue-400 transition-colors border border-zinc-200 group" style="padding: 8px">
                            <div class="flex items-center gap-4">
                                <div class="w-16 h-16 flex-shrink-0">
                                    <img src="@item.AnhBia" alt="Genshin Impact (UID)" class="w-full h-full object-cover rounded-lg border border-zinc-200">
                                </div>
                                <div class="flex-1">
                                    <h3 class="text-zinc-800 font-medium">@item.Name</h3>
                                    <p class="text-green-500 text-sm flex items-center gap-2">
                                        <span class="inline-flex items-center text-center align-[-.125em] text-[16px]">
