                                                <path d="M10.831 8.154c.19-.937 1.076-1.682 2.027-1.682s1.578.69 1.56 1.58c.991.025 1.267-1.28 1.267-1.28a29 29 0 0 0 .313-1.775 1.2 1.2 0 0 0-.076-.638 11 11 0 0 0-.936-1.734c-.343-.512-.92-.816-1.578-.827-.393-.006-.778-.01-1.07-.01l-.002-.002A1.22 1.22 0 0 0 11.2.62C10.781.583 9.126.556 8.332.556c-.316 0-.769.004-1.227.012V.566h-.003L7.1.565H1.592a.534.534 0 0 0-.534.534v.003c0 .293.238.531.531.531l1.11.002a.53.53 0 0 1 .493.53v.002c0 .295-.24.534-.534.534H2.09a.534.534 0 0 0 0 1.067h.569a.534.534 0 0 1 0 1.068H.53a.534.534 0 0 0 0 1.067h2.13a.534.534 0 0 1 0 1.068H2a.534.534 0 0 0 0 1.067l2.102-.001.175-.436c.358-.66 1.07-1.128 1.823-1.128.953 0 1.63.746 1.554 1.684h3.176m1.457-5.628c.279 0 .64.004 1.003.01.44.007.824.208 1.054.553.28.417.503.83.664 1.16.103.21-.086.484-.335.484H12.01z" fill="#12CBAB"></path>
                                                <path d="M11.199.62C10.78.582 9.126.555 8.332.555c-.316 0-.769.005-1.227.012V.565H1.593a.534.534 0 0 0-.534.534v.003c0 .293.238.53.531.53l1.11.002a.53.53 0 0 1 .493.53v.003c0 .294-.24.533-.534.533H2.09a.534.534 0 0 0 0 1.068h.569a.534.534 0 0 1 0 1.067H.53a.53.53 0 0 0-.526.45v.17c.04.253.26.448.526.448h2.13a.534.534 0 0 1 .415.868 8.8 8.8 0 0 0 2.145-.083c.273-.137.574-.215.881-.215l.08.001A8.66 8.66 0 0 0 11.985.982 1.25 1.25 0 0 0 11.2.62" fill="#55E6CD"></path>
