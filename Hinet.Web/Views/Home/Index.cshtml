@using Hinet.Service.Constant
@model Hinet.Web.Models.HomeVM
@{
    var listGameTrangChu = Model.ListGame.Where(x => x.ViTriHienThi != ViTriHienThiGameConstant.KHAC).ToList();
    var listGameKhac = Model.ListGame.Where(x => x.ViTriHienThi == ViTriHienThiGameConstant.KHAC).ToList();
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
    var siteConfig = Model.SiteConfig;
}

<div class="content" style="">
    <div class="container c-container">
        <div class="ads-banner row c-mt-16 c-mt-md-0 c-pb-12 c-pb-lg-28 banner-top-charge justify-content-center">
            <!-- Cột trái: Top nạp thẻ -->
            @*<div class="content-banner-card col-lg-3 col-md-12 c-mb-16 c-mb-lg-0">
                @Html.Action("TopNapThe", "Home", new { area = "" })
            </div>*@

            <!-- Cột phải: Banner slide -->
            <div class="banner-slide col-lg-9 col-md-12 swiper-general c-mb-16">
                <div class="swiper swiper-banner brs-8">
                    <div class="swiper-wrapper">
                        @foreach (var item in Model.ListBanner)
                        {
                            <div class="swiper-slide">
                                <a href="@item.Link" target="_blank">
                                    <img src="@Url.Content(item.DuongDanAnh)"
                                         alt="@item.Name"
                                         class="img-fluid w-100 brs-8"
                                         onerror="imgError(this)" />
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Navigation -->
                    <div class="navigation slider-next">
                        <i class="bi bi-chevron-right"></i>
                    </div>
                    <div class="navigation slider-prev">
                        <i class="bi bi-chevron-left"></i>
                    </div>
                </div>

                <!-- Pagination -->
                <div class="swiper-pagination"></div>
            </div>
        </div>
        <!-- Start gian hàng nổi bật -->
        <div class="container mt-10">
            <div class="mb-2">
                <div class="flex items-center gap-2">
                    <span class="text-orange-500">🔥</span>
                    <h2 class="text-zinc-800 font-medium uppercase text-xl">NỔI BẬT</h2>
                </div>
                <p class="text-gray-400 text-sm">Các tựa game được ưu chuộng nhất hiện nay</p>
