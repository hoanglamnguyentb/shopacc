    <script>
        $(document).ready(function () {
            // Countdown timer variables
            let qrCountdownTimer = null;
            let qrCountdownSeconds = 600;

            function startQrCountdown() {
                clearInterval(qrCountdownTimer);
                qrCountdownSeconds = 600;
                $('#qrCountdownBlock').show();
                updateQrCountdownDisplay();
                qrCountdownTimer = setInterval(function () {
                    qrCountdownSeconds--;
                    updateQrCountdownDisplay();
                    if (qrCountdownSeconds <= 0) {
                        clearInterval(qrCountdownTimer);
                        location.reload();
                    }
                }, 1000);
            }

            function updateQrCountdownDisplay() {
                let min = Math.floor(qrCountdownSeconds / 60);
                let sec = qrCountdownSeconds % 60;
                let text = (min < 10 ? '0' : '') + min + ':' + (sec < 10 ? '0' : '') + sec;
                $('#qrCountdown').text(text);
            }

            // Handle click on "Đã chuyển khoản"
            $(document).on('click', '#btnTransferDone', function () {
                location.reload();
            });

            // Handle click on "Đã chuyển khoản" in modal
            $(document).on('click', '#btnTransferDoneModal', function () {
                location.reload();
            });

            // Function to handle QR generation (common for both main and modal)
            function generateQR(amountSelector, errorSelector, buttonSelector, contentSelector, qrSelector, sectionSelector) {
                const amount = $(amountSelector).val();
                const $errorDiv = $(errorSelector);
                const $button = $(buttonSelector);

                // Clear previous errors
                $errorDiv.text('');

                // Validate amount
                if (!amount || amount < 10000) {
                    $errorDiv.text('Vui lòng nhập số tiền tối thiểu 10,000 VND');
                    return;
                }

                // Disable button and show loading
                $button.prop('disabled', true).addClass('btn-loading').html('<i class="bi bi-arrow-repeat spin c-mr-8"></i>Đang tạo mã QR...');

                // Call API to get transaction code
                $.ajax({
                    url: '/DepositArea/Deposit/GenerateCode', // Update this URL to your actual API endpoint
                    method: 'POST',
                    data: {
                        amount: amount
                    },
                    success: function (response) {
                        if (response.success && response.code) {
                            // Update transaction content
                            $(contentSelector).text(response.code);

                            // Generate QR URL
                            const qrUrl = `https://img.vietqr.io/image/TPB-64162761703-compact2.png?amount=${amount}&addInfo=${encodeURIComponent(response.code)}&accountName=TRUONG%20DAN%20TRUONG`;

                            // Update QR image
                            $(qrSelector).attr('src', qrUrl).show();

                            // Show transaction section
                            $(sectionSelector).show();
                            // Show countdown and transfer button
                            $('#qrCountdownBlock').show();
                            startQrCountdown();

                            // Re-enable button with success state
                            $button.prop('disabled', false).removeClass('btn-loading').html('<i class="bi bi-check-circle c-mr-8"></i>Tạo thành công');

                            // Reset button after 2 seconds
                            setTimeout(function () {
                                $button.html('<i class="bi bi-qr-code c-mr-8"></i>Tạo mã QR chuyển khoản');
                            }, 2000);
                        } else {
                            $errorDiv.text('Không thể tạo mã QR. Vui lòng thử lại.');
                            $button.prop('disabled', false).removeClass('btn-loading').html('<i class="bi bi-qr-code c-mr-8"></i>Tạo mã QR chuyển khoản');
                        }
                    },
                    error: function () {
                        $errorDiv.text('Lỗi kết nối. Vui lòng thử lại.');
                        $button.prop('disabled', false).removeClass('btn-loading').html('<i class="bi bi-qr-code c-mr-8"></i>Tạo mã QR chuyển khoản');
                    }
                });
            }

            // Handle generate QR button click for main page
            $('#generateQrBtn').click(function () {
                generateQR('#rechargeAmount', '#amountError', '#generateQrBtn', '#transactionContent', '#transactionQrContent', '#transactionSection');
            });

            // Handle generate QR button click for modal
            $('#generateQrBtnModal').click(function () {
                generateQR('#rechargeAmountModal', '#amountErrorModal', '#generateQrBtnModal', '#transactionContentModal', '#transactionQrContentModal', '#transactionSectionModal');
            });

            // Handle copy transaction content for main page
            $('.js-copy-text').click(function () {
                const textToCopy = $('#transactionContent').text();
                if (textToCopy && textToCopy !== 'Vui lòng nhập số tiền và tạo mã QR') {
                    navigator.clipboard.writeText(textToCopy).then(function () {
                        alert('Đã sao chép nội dung chuyển khoản!');
                    });
                }
            });

            // Handle copy transaction content for modal
            $('.js-copy-text-modal').click(function () {
                const textToCopy = $('#transactionContentModal').text();
                if (textToCopy && textToCopy !== 'Vui lòng nhập số tiền và tạo mã QR') {
                    navigator.clipboard.writeText(textToCopy).then(function () {
                        alert('Đã sao chép nội dung chuyển khoản!');
                    });
                }
            });

            // Format number input for main page
            $('#rechargeAmount').on('input', function () {
                let value = $(this).val();
                // Remove any non-digit characters
                value = value.replace(/\D/g, '');
                $(this).val(value);

                // Add visual feedback for valid amount
                if (value >= 10000) {
                    $(this).removeClass('error').addClass('success');
                    $('#amountError').text('');
                } else if (value) {
                    $(this).removeClass('success').addClass('error');
                } else {
                    $(this).removeClass('success error');
                }
            });

            // Format number input for modal
            $('#rechargeAmountModal').on('input', function () {
                let value = $(this).val();
                // Remove any non-digit characters
                value = value.replace(/\D/g, '');
                $(this).val(value);

                // Add visual feedback for valid amount
                if (value >= 10000) {
                    $(this).removeClass('error').addClass('success');
                    $('#amountErrorModal').text('');
                } else if (value) {
                    $(this).removeClass('success').addClass('error');
                } else {
                    $(this).removeClass('success error');
                }
            });

            // Add placeholder animation
            $('#rechargeAmount, #rechargeAmountModal').on('focus', function () {
                $(this).attr('placeholder', 'Ví dụ: 50000');
            }).on('blur', function () {
                $(this).attr('placeholder', 'Nhập số tiền (VND)');
            });
        });
    </script>

