@using Hinet.Service.Constant;
@{
    var config = ViewBag.SiteConfig as Hinet.Model.Entities.SiteConfig;
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
}

<div class="container">
    <ul class="breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
        </li>
        <li class="breadcrumb-item">
            <a href="#" class="breadcrumb-link">Nạp tài khoản</a>
        </li>
    </ul>
    <hr />
</div>

<div class="container mt-10">
    <div class="mb-2">
        <div class="flex items-center gap-2 justify-content-center">
            <h2 class="text-zinc-800 font-medium uppercase text-xl">Tạo mã QR</h2>
        </div>
        <p class="text-gray-400 text-sm text-center">Hệ thống sẽ tạo mã QR tương ứng với số tiền bạn nhập</p>
    </div>
    <!-- Input field for amount -->
    <div class="money-form-group">
        <div class="input-group d-flex flex-column">
            <input class="input-form m-auto" id="rechargeAmount"
                    inputmode="numeric"
                    type="text" placeholder="Nhập số tiền muốn nạp (đ)" style="height: 34px; max-width: 250px">
            <p class="text-error c-mb-0 c-mt-4 w-full text-center" id="amountError"></p>
        </div>
        <div class="text-center c-mt-12">
            <button class="btn primary m-auto" id="generateQrBtn" type="button">
                <i class="bi bi-qr-code c-mr-8"></i>
                Tạo mã QR
            </button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/autonumeric@4.6.0/dist/autoNumeric.min.js"></script>
<script>
    $(document).ready(function () {

        let qrCountdownTimer = null;
        let qrCountdownSeconds = 600;

        function startQrCountdown() {
            clearInterval(qrCountdownTimer);
            qrCountdownSeconds = 600;
            $('#qrCountdownBlock').show();
            updateQrCountdownDisplay();
            qrCountdownTimer = setInterval(function () {
                qrCountdownSeconds--;
                updateQrCountdownDisplay();
                if (qrCountdownSeconds <= 0) {
                    clearInterval(qrCountdownTimer);
                    location.reload();
                }
            }, 1000);
        }

        function updateQrCountdownDisplay() {
            let min = Math.floor(qrCountdownSeconds / 60);
            let sec = qrCountdownSeconds % 60;
            let text = (min < 10 ? '0' : '') + min + ':' + (sec < 10 ? '0' : '') + sec;
            $('#qrCountdown').text(text);
        }

        const rechargeAmountAutoNumeric = new AutoNumeric('#rechargeAmount', {
            digitGroupSeparator: '.',
            decimalCharacter: ',',
            decimalPlaces: 0,
            minimumValue: '0',
            modifyValueOnWheel: false
        });


        // Tạo QR cho input chính
        $('#generateQrBtn').click(function () {
            const amount = rechargeAmountAutoNumeric.getNumber();
            var data = {
                SoTien: amount,
                LoaiGiaoDich: '@LoaiGiaoDichConstant.NAPTHUONG',
            };
            Swal.fire({
                title: 'Đang tạo đơn nạp...',
                text: 'Vui lòng chờ trong giây lát',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            $.ajax({
                url: '/GiaoDich/TaoGiaoDichVaQRCode',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json',
                success: function (res) {
                    console.log(res);
                    Swal.close();
                    if (res.Success && res.Data) {
                        console.log("Thanh cong");

                        $('#rechargeQrImage').attr('src', res.Data.QrUrl).show();
                        $("#displayAmount").text(res.Data.SoTien.toLocaleString('vi-VN') + ' đ')
                        $("#displayNoiDung").text(res.Data.NoiDungChuyenKhoan)
                        $('#rechargeModal').modal('show');
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: res.Error || res.Message || 'Có lỗi xảy ra, vui lòng thử lại!'
                        });
                    }
                },
                error: function (err) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Không kết nối được server!'
                    });
                }
            });
        });

        $('.js-copy-text').click(function () {
            const textToCopy = $('#transactionContent').text();
            if (textToCopy && textToCopy !== 'Vui lòng nhập số tiền và tạo mã QR') {
                navigator.clipboard.writeText(textToCopy).then(function () {
                    alert('Đã sao chép nội dung chuyển khoản!');
                });
            }
        });

        $('.js-copy-text-modal').click(function () {
            const textToCopy = $('#transactionContentModal').text();
            if (textToCopy && textToCopy !== 'Vui lòng nhập số tiền và tạo mã QR') {
                navigator.clipboard.writeText(textToCopy).then(function () {
                    alert('Đã sao chép nội dung chuyển khoản!');
                });
            }
        });

        $('#rechargeAmount, #rechargeAmountModal').on('focus', function () {
            $(this).attr('placeholder', 'Ví dụ: 50.000');
        }).on('blur', function () {
            $(this).attr('placeholder', 'Nhập số tiền (đ)');
        });

        $(document).on('click', '#btnTransferDone, #btnTransferDoneModal', function () {
            location.reload();
        });
    });
</script>


