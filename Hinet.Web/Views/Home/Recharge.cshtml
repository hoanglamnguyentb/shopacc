@{
    var config = ViewBag.SiteConfig as Hinet.Model.Entities.SiteConfig;
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
}

<div class="content" style="">

    <div class="container c-container">
        <ul class="breadcrumb-list">
            <li class="breadcrumb-item">
                <a href="/" class="breadcrumb-link">Trang chủ</a>
            </li>
            <li class="breadcrumb-item">
                <a href="#" class="breadcrumb-link">Nạp thẻ</a>
            </li>
        </ul>
        <hr />

        <div class="sidebar-section brs-12">
            <p class="sidebar-section-title c-mb-16 text-center fz-20 text-uppercase">Tạo mã QR để thanh toán</p>
            <!-- Input field for amount -->
            <div class="money-form-group">
                <div class="input-group d-flex flex-column">
                    <input class="input-form m-auto" id="rechargeAmount"
                           inputmode="numeric"
                           type="text" placeholder="Nhập số tiền muốn nạp (VND)" style="height: 34px; max-width: 250px">
                    <p class="text-error c-mb-0 c-mt-4 w-full text-center" id="amountError"></p>
                </div>
                <div class="text-center c-mt-12">
                    <button class="btn primary m-auto" id="generateQrBtn" type="button">
                        <i class="bi bi-qr-code c-mr-8"></i>
                        Tạo mã QR
                    </button>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="atm-recharge-right c-p-16 brs-8 col-6">
                <div class="atm-recharge-content c-p-sm-12 brs-sm-8">
                    <div id="transactionSection" style="display: none;">
                        <div class="text-center">
                            <img id="transactionQrContent" src="" alt="Mã QR chuyển khoản" height="320" style="display: none;" class="border shadow-sm rounded-lg">
                        </div>
                        <table class="table table-bordered text-center align-middle table-sm mt-4">
                            <tbody>
                                <tr>
                                    <th scope="row" style="width: 40%;">Thụ hưởng</th>
                                    <td>@config.AccountName</td>
                                </tr>
                                <tr>
                                    <th scope="row">Số tài khoản</th>
                                    <td>@config.AccountNumber</td>
                                </tr>
                                <tr>
                                    <th scope="row">Số tiền</th>
                                    <td><span id="displayAmount"></span></td>
                                </tr>
                                <tr>
                                    <th scope="row">Nội dung chuyển khoản</th>
                                    <td><strong>NAPTHUONG #@currentUser.Id</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/autonumeric@4.6.0/dist/autoNumeric.min.js"></script>
<script>
    $(document).ready(function () {

        let qrCountdownTimer = null;
        let qrCountdownSeconds = 600;

        function startQrCountdown() {
            clearInterval(qrCountdownTimer);
            qrCountdownSeconds = 600;
            $('#qrCountdownBlock').show();
            updateQrCountdownDisplay();
            qrCountdownTimer = setInterval(function () {
                qrCountdownSeconds--;
                updateQrCountdownDisplay();
                if (qrCountdownSeconds <= 0) {
                    clearInterval(qrCountdownTimer);
                    location.reload();
                }
            }, 1000);
        }

        function updateQrCountdownDisplay() {
            let min = Math.floor(qrCountdownSeconds / 60);
            let sec = qrCountdownSeconds % 60;
            let text = (min < 10 ? '0' : '') + min + ':' + (sec < 10 ? '0' : '') + sec;
            $('#qrCountdown').text(text);
        }

        const rechargeAmountAutoNumeric = new AutoNumeric('#rechargeAmount', {
            digitGroupSeparator: '.',
            decimalCharacter: ',',
            decimalPlaces: 0,
            minimumValue: '0',
            modifyValueOnWheel: false
        });

        function generateQR(autoNumericInstance, errorSelector, buttonSelector, contentSelector, qrSelector, sectionSelector) {
            const amount = autoNumericInstance.getNumber();
            const $errorDiv = $(errorSelector);
            const $button = $(buttonSelector);

            $errorDiv.text('');

            if (!amount || amount < 10000) {
                $errorDiv.text('Vui lòng nhập số tiền tối thiểu 10,000 VND');
                return;
            }
            const url = "/DepositArea/Deposit/GenerateCode"
            $.post(url, { amount }, function (res) {
                debugger
                if (res.success) {
                    $('#displayAmount').text(amount.toLocaleString('vi-VN') + ' VND');
                    $button.prop('disabled', true).addClass('btn-loading')
                        .html('<i class="bi bi-arrow-repeat spin c-mr-8"></i>Đang tạo mã QR...');

                    try {
                        const transactionCode = res.code;
                        $(contentSelector).text(transactionCode);

                        const bankCode = '@config.BankCode';
                        const accountNumber = '@config.AccountNumber';
                        const accountName = encodeURIComponent('@config.AccountName');

                        const qrUrl = `https://img.vietqr.io/image/${bankCode}-${accountNumber}-compact2.png?amount=${amount}&addInfo=${encodeURIComponent(transactionCode)}&accountName=${accountName}`;

                        $(qrSelector).attr('src', qrUrl).show();
                        $(sectionSelector).show();
                        $('#qrCountdownBlock').show();
                        startQrCountdown();

                        $button.prop('disabled', false).removeClass('btn-loading')
                            .html('<i class="bi bi-check-circle c-mr-8"></i>Tạo thành công');

                        setTimeout(function () {
                            $button.html('<i class="bi bi-qr-code c-mr-8"></i>Tạo mã QR');
                        }, 2000);

                    } catch (e) {
                        $errorDiv.text('Không thể tạo mã QR. Vui lòng thử lại.');
                        $button.prop('disabled', false).removeClass('btn-loading')
                            .html('<i class="bi bi-qr-code c-mr-8"></i>Tạo mã QR');
                            }
                    }
            }).fail(() => {
                console.error("An error occurss");
            });
        }

        // 📌 Tạo QR cho input chính
        $('#generateQrBtn').click(function () {
            generateQR(rechargeAmountAutoNumeric, '#amountError', '#generateQrBtn', '#transactionContent', '#transactionQrContent', '#transactionSection');
        });

        // 📌 Tạo QR cho input trong modal (nếu có)
        $('#generateQrBtnModal').click(function () {
            if (rechargeAmountModalAutoNumeric) {
                generateQR(rechargeAmountModalAutoNumeric, '#amountErrorModal', '#generateQrBtnModal', '#transactionContentModal', '#transactionQrContentModal', '#transactionSectionModal');
            }
        });

        $('.js-copy-text').click(function () {
            const textToCopy = $('#transactionContent').text();
            if (textToCopy && textToCopy !== 'Vui lòng nhập số tiền và tạo mã QR') {
                navigator.clipboard.writeText(textToCopy).then(function () {
                    alert('Đã sao chép nội dung chuyển khoản!');
                });
            }
        });

        $('.js-copy-text-modal').click(function () {
            const textToCopy = $('#transactionContentModal').text();
            if (textToCopy && textToCopy !== 'Vui lòng nhập số tiền và tạo mã QR') {
                navigator.clipboard.writeText(textToCopy).then(function () {
                    alert('Đã sao chép nội dung chuyển khoản!');
                });
            }
        });

        $('#rechargeAmount, #rechargeAmountModal').on('focus', function () {
            $(this).attr('placeholder', 'Ví dụ: 50.000');
        }).on('blur', function () {
            $(this).attr('placeholder', 'Nhập số tiền (VND)');
        });

        $(document).on('click', '#btnTransferDone, #btnTransferDoneModal', function () {
            location.reload();
        });
    });
</script>


