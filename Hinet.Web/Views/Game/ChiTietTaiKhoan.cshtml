                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>
                                                            <span class="link-color">
                                                                Mật khẩu
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <div class="password-wrapper" style="display: inline-flex; align-items: center; gap: 4px;">
                                                                <input type="password"
                                                                       value="@Model.Password"
                                                                       readonly
                                                                       class="password-field"
                                                                       style="border: none; background: transparent; padding: 0; width: auto; display: inline-block; text-align: right;" />

                                                                <span 
                                                                        class="toggle-password p-0"
                                                                        title="Hiện/ẩn mật khẩu"
                                                                        style="text-decoration: none;">
                                                                    <i class="bi bi-eye"></i>
                                                                </span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }

                            @if (Model.TrangThai == Hinet.Service.Constant.TrangThaiTaiKhoanConstant.CHUABAN)
                            {
                                <div class="card disabled-color">
                                    <div class="card-body text-center c-p-0">
                                        @if (Model.GiaKhuyenMai.HasValue)
                                        {
                                            <div class="price-acc">
                                                <div class="price-old fz-lg-12 lh-lg-16">
                                                    @NumberHelper.FormatMoneyVN(Model.GiaGoc)
                                                </div>
