                            </div>
                            <div class="card--attr__value fz-13 fw-500">
                                @danhMuc.Name
                            </div>
                        </div>
                        <div class="card--attr justify-content-between d-flex c-mb-16 text-center">
                            <div class="card--attr__name fw-400 fz-13 text-center">
