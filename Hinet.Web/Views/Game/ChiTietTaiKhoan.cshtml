@using CommonHelper.Number;
@model Hinet.Service.TaiKhoanService.Dto.TaiKhoanDto
@{
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
    var game = Model.Game;
    var danhMuc = Model.DanhMucGame;
    var giaThanhToan = Model.GiaKhuyenMai.HasValue ? Model.GiaKhuyenMai : Model.GiaGoc;
    var thanhToanDuoc = currentUser != null && currentUser.Balance >= giaThanhToan;
    var isNguoiMua = currentUser != null &&  currentUser.Id == Model.IdNguoiMuaAcc;
    var isChoPhepTruyCap = (currentUser != null && currentUser.Id == Model.IdNguoiMuaAcc)
                       || danhMuc.LaLoaiDongGia != true;
    if (!isChoPhepTruyCap)
    {
        <div class="empty w-100 d-flex flex-column justify-content-center align-items-center c-mt-48" id="text-empty">
            <img src="/assets/wwwroot/images/no-image.png" alt="empty state" />
            <div class="text-muted text-center" style="max-width: 700px;">
                Đường dẫn không tồn tại.
            </div>
        </div>
        return;
    }
}

<div class="container c-container" id="account-detail">
    <div class="data__menuacc">
        <ul class="breadcrumb-list">
            <li class="breadcrumb-item">
                <a href="/" class="breadcrumb-link">Trang chủ</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/game/@game.Slug" class="breadcrumb-link">@game.Name</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/mua-acc/@danhMuc.Slug" class="breadcrumb-link">
                    @danhMuc.Name
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="javascript:void(0)" class="breadcrumb-link">Chi tiết nick</a>
            </li>
        </ul>
    </div>
    <hr />
    <section class="acc-detail data-account-detail">
        <div class="section-content row">
            <div class="col-12 col-lg-7 c-pr-8 c-pr-lg-15 c-pt-16">
                <div class="card account-thumb">
                    <div class="card-body">
                        <!-- Swiper -->
                        <div class="swiper swiper-chitiet-tk brs-8" style="height: 400px">
                            <div class="swiper-wrapper">
                                @foreach (var item in Model.TaiLieuDinhKemList)
                                {
                                    <div class="swiper-slide">
                                        <img src="@Url.Content(item.DuongDanFile)"
                                             alt="@item.TenTaiLieu"
                                             onerror="imgError(this)" />
                                    </div>
                                }
                            </div>
                            <div class="navigation slider-next"><i class="bi bi-chevron-right"></i></div>
                            <div class="navigation slider-prev"><i class="bi bi-chevron-left"></i></div>
                        </div>
                        <div class="swiper-pagination"></div>


                    </div>
                </div>
                <div class="card">
                    <div class="card-body c-px-16">
                        <!-- Swiper thumbnail (ảnh nhỏ) -->
                        <div thumbsSlider="" class="swiper swiper-chitiet-thumbs c-mt-12">
                            <div class="swiper-wrapper">
                                @foreach (var item in Model.TaiLieuDinhKemList)
                                {
                                    <div class="swiper-slide" style="width:80px;height:80px;cursor:pointer;">
                                        <img src="@Url.Content(item.DuongDanFile)"
                                             alt="@item.TenTaiLieu"
                                             class="w-100 h-100 object-cover brs-4"
                                             onerror="imgError(this)" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Mota))
                {
                    <div class="card border shadow-sm c-p-16 c-mt-16">
                        <div class="card-body">
                            <h2 class="text-title-bold d-none d-lg-block c-mb-24 detailViewBlockTitle">Chi tiết dịch vụ</h2>
                            <div class="content-desc detailViewBlockContent">
                                @Model.Mota
                            </div>
                        </div>
                    </div>
                }

            </div>

            <div class="col-12 col-lg-5 c-pl-8 c-pl-lg-15">
                <div class="js_sticky" data-top="140">
                    <div class="card account-detail-info">
                        <div class="card-body c-p-16 mx-n3 mx-lg-0">
                            <div class="section-title title-color fz-lg-18 lh-lg-24">
                                @danhMuc.Name
                            </div>
                            <div class="text-title fw-700 c-mb-6 d-none d-lg-block">Mã số: #@Model.Code</div>
                            @if (Model.ListGTTT.Any())
                            {
                                <hr>
                                <div class="text-title c-py-8 d-none d-lg-block">
                                    Thông tin acc
                                </div>
                                <div class="row marginauto">
                                    <div class="col-md-12 pr-0 scroll-default" style="padding-left: 0">
                                        <table class="table-acc-info c-mb-24 d-none d-lg-table">
                                            <tbody>
                                                @foreach (var tt in Model.ListGTTT)
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="link-color">
                                                                @tt.ThuocTinhTxt
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span>
                                                                @tt.GiaTriTxt
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }

                                                @if (isNguoiMua)
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="link-color">
                                                                Tài khoản
                                                            </span>
                                                        </td>
                                                        <td>
