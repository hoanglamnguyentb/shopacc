<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>

<script>
    var isLoggedIn = @(currentUser != null ? "true" : "false");

    // Mở modal thanh toán
    $('body').on('click', '#account-detail .btn-muangay', function (e) {
        e.preventDefault();
        if (!isLoggedIn) {
            openLoginModal();
            return;
        }
        $('#orderModal').modal('show');
    });

    // Mở modal nạp tiền
    $('body').on('click', '.handle-recharge-modal', function (e) {
        e.preventDefault();
        if (!isLoggedIn) {
            openLoginModal();
            return;
        }
        $('#rechargeModal').modal('show');
    });

    // 🧠 Xác nhận khi bấm nút Thanh toán
    $('body').on('click', '#ajaxOrderForm button[type="submit"]', function (e) {
        e.preventDefault();
        const $form = $(this).closest('form');
        const amountText = $('#orderModal .data_total_price').text().trim();

        Swal.fire({
            title: 'Xác nhận thanh toán',
            html: `Bạn có chắc chắn muốn thanh toán <strong>${amountText}</strong> cho giao dịch này không?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Có, thanh toán',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33'
        }).then((result) => {
            if (result.isConfirmed) {
                $form.off('submit'); // ⬅️ Gỡ sự kiện submit chặn
                $form.submit();      // ✅ Lúc này form sẽ gửi thật qua Ajax.BeginForm
            }
        });
    });

    function onPaymentBegin() {
        Swal.fire({
            title: 'Đang xử lý',
            text: 'Vui lòng đợi trong giây lát...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
    }

    // ✅ Xử lý kết quả thanh toán
    function onPaymentSuccess(result) {
        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: 'Thanh toán thành công!',
                confirmButtonText: 'OK',
                confirmButtonColor: '#3085d6'
            }).then(() => {
                location.reload();
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: result.message || "Có lỗi xảy ra khi thanh toán.",
                confirmButtonText: 'Đóng',
                confirmButtonColor: '#d33'
            }).then(() => {
                location.reload();
            });
        }
    }

    // Lỗi kết nối
    function onPaymentFailure(xhr) {
        Swal.fire({
            icon: 'error',
            title: 'Kết nối thất bại',
            text: 'Không thể kết nối tới máy chủ. Vui lòng thử lại sau.',
            confirmButtonText: 'Đóng',
            confirmButtonColor: '#d33'
        }).then(() => {
            location.reload();
        });
    }

    // Hàm tạo mã QR cho nạp tiền
    function generateVietQR(bankCode, accountNumber, accountName, amount, transferContent) {
        if (!bankCode || !accountNumber || !accountName || !amount || !transferContent) {
            throw new Error("Thiếu thông tin cần thiết để tạo mã QR");
        }
        const baseUrl = `https://img.vietqr.io/image/${encodeURIComponent(bankCode)}-${encodeURIComponent(accountNumber)}-compact2.png`;
        const params = new URLSearchParams({
            amount: amount,
            addInfo: transferContent,
            accountName: accountName
        });
        return `${baseUrl}?${params.toString()}`;
    }

    // Nạp tiền
    $('body').on('click', '.handle-recharge-modal', function (e) {
        e.preventDefault();
        if (!isLoggedIn) {
            openLoginModal();
            return;
        }

        const amount = @giaThanhToan;
        const transferCode = 'NAP' + '@(currentUser != null ? currentUser.Id.ToString() : "")';
        const bankCode = 'TPB';
        const accountNumber = '64162761703';
        const accountName = 'TRUONG DAN TRUONG';

        try {
            const qrUrl = generateVietQR(bankCode, accountNumber, accountName, amount, transferCode);
            $('#rechargeQrImage').attr('src', qrUrl).show();
            $('#qrInfoText').html(
                `<strong>Số tiền:</strong> ${amount.toLocaleString()} VND<br>
                 <strong>Nội dung chuyển khoản:</strong> ${transferCode}`
            );
        } catch (err) {
            console.error(err);
            $('#qrInfoText').text('Không thể tạo mã QR. Vui lòng thử lại.');
        }

        $('#rechargeModal').modal('show');
    });

    // Thumbnail swiper
    var thumbTKSwiper = new Swiper(".swiper-chitiet-thumbs", {
        loop: false,
        spaceBetween: 10,
        slidesPerView: 4,
        freeMode: true,
        watchSlidesProgress: true,
        watchSlidesVisibility: true,
        breakpoints: {
            0: { slidesPerView: 3 },
            768: { slidesPerView: 4 },
            1024: { slidesPerView: 5 },
        },
    });

    var chitietTK_slide = new Swiper(".swiper-chitiet-tk", {
        loop: false,
        slidesPerView: 1,
        speed: 600,
        navigation: {
            nextEl: '.swiper-chitiet-tk .navigation.slider-next',
            prevEl: '.swiper-chitiet-tk .navigation.slider-prev',
        },
        thumbs: {
            swiper: thumbTKSwiper,
        },
    });
</script>

<script>
    $(document).on('click', '.toggle-password', function () {
        const $btn = $(this);
        const $input = $btn.siblings('.password-field');

        if ($input.attr('type') === 'password') {
            $input.attr('type', 'text');
            $btn.find('i').removeClass('bi-eye').addClass('bi-eye-slash');
        } else {
            $input.attr('type', 'password');
            $btn.find('i').removeClass('bi-eye-slash').addClass('bi-eye');
        }
    });
</script>