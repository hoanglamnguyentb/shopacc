                                            </div>
                                        }
                                        else
                                        {
                                            <div class="price-acc">
                                                <div class="price-old fz-lg-12 lh-lg-16">
                                                    @NumberHelper.FormatMoneyVN(Model.GiaGoc)
                                                </div>
                                            </div>
                                        }
                                        <span>
                                            Rẻ vô đối, giá tốt nhất thị trường
                                        </span>
                                    </div>
                                </div>

                                <div class="c-py-24">
                                    <hr>
                                </div>

                                if (!isNguoiMua)
                                {
                                    <div class="group-btn c-mb-16 d-none d-lg-flex" style="--data-between: 12px">
                                        @if (currentUser != null)
                                        {
                                            <button type="button"
                                                    class="btn primary btn-muangay buyacc google_buy_account h-auto"
                                                    data-id="@Model.Id">
                                                Mua ngay
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn primary buyacc google_buy_account h-auto"
                                                    onclick="openLoginModal()">
                                                Mua ngay
                                            </button>
                                        }
                                    </div>

                                    <div class="login-via fw-400 c-my-16 text-center">hoặc</div>

                                    <div class="group-btn d-none d-lg-flex" style="--data-between: 12px">
                                        @if (currentUser != null)
                                        {
                                            <a href="javascript:void(0);" class="handle-recharge-modal btn pink two-line d-block">
                                                <span class="line-1" style="white-space: nowrap;">Mua bằng ATM, Momo</span>
                                                <span class="line-2">
                                                    @NumberHelper.FormatMoneyVN(Model.GiaKhuyenMai ?? Model.GiaGoc)
                                                </span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="javascript:void(0);" class="btn pink two-line d-block" onclick="openLoginModal()">
                                                <span class="line-1" style="white-space: nowrap;">Mua bằng ATM, Momo</span>
                                                <span class="line-2">
                                                    @NumberHelper.FormatMoneyVN(Model.GiaKhuyenMai ?? Model.GiaGoc)
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Start Tài khoản liên quan -->
        @Html.Action("TaiKhoanLienQuan", "Game", new { id = game.Id, area = "" })
        <!-- End Tài khoản liên quan -->
        <!-- Start Tài khoản đã xem -->
        @Html.Action("TaiKhoanDaXem", "Game", new { id = game.Id, area = "" })
        <!-- End Tài khoản đã xem -->

    </section>
</div>
