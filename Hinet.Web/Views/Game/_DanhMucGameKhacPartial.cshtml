@model List<Hinet.Service.DanhMucGameService.Dto.DanhMucGameDto>

@if (Model != null && Model.Count() > 0)
{
    <div class="mt-10">
        <section class="section-related-service related-category">
            <div class="mb-2">
                <div class="flex items-center gap-2">
                    <h2 class="text-zinc-800 font-medium uppercase text-xl mr-auto">Mua tài khoản game khác</h2>
                    <a href="/game" class="link arr-right btn-link">Xem tất cả</a>
                </div>
            </div>
            <div class="swiper swiper-related-service card-list swiper-container-horizontal">
                <div class="swiper-wrapper">
                    @foreach (var dmGame in Model)
                    {
                        <div class="swiper-slide" style="width: 233.6px; margin-right: 16px;">
                            @Html.Partial("_ItemDMGameCategory", dmGame)
                        </div>
                    }
                </div>
                <div class="navigation slider-next"><i class="bi bi-chevron-right"></i></div>
                <div class="navigation slider-prev"><i class="bi bi-chevron-left"></i></div>
            </div>
        </section>
    </div>
}
