@model List<Hinet.Service.DanhMucGameService.Dto.DanhMucGameDto>
@using CommonHelper.Number

<div class="container mt-10" id="account-list">
    <ul class="breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
        </li>
        <li class="breadcrumb-item">
            <a href="javascript:void(0)" class="breadcrumb-link">Tìm kiếm</a>
        </li>
    </ul>
    <hr>
    <section class="listing-service c-mb-16">
        <div class="section-header justify-content-between c-py-16">
            <h2 class="section-title">
                @Model.Count Kết quả tìm kiếm
            </h2>
        </div>
        <div class="list-category">
            @if (!Model.Any())
            {
                @Html.Partial("_EmptyState", "Hiện tại không có dữ liệu phù hợp với yêu cầu của bạn.<br />Hệ thống sẽ được cập nhật thường xuyên, vui lòng quay lại sau để theo dõi thông tin mới nhất")
            }
            else
            {
                foreach (var dmGame in Model)
                {
                    @Html.Partial("_ItemDMGameCategory", dmGame)
                }
            }
        </div>
    </section>

</div>


