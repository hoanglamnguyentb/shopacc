@{
    ViewBag.Title = "Đã xảy ra lỗi";
    Layout = "~/Views/Shared/_LayoutBlank.cshtml";
    var errorMessage = "Có vẻ đã có sự cố xảy ra. Hãy thử tải lại trang hoặc quay về trang chủ để tiếp tục";
    if (System.Web.HttpContext.Current.IsDebuggingEnabled)
    {
        var exceptionContext = TempData["filterContext"] as System.Web.Mvc.ExceptionContext;
        if (exceptionContext != null && exceptionContext.Exception != null)
        {
            errorMessage = exceptionContext.Exception.ToString();
        }
    }
}

@Html.Partial("_EmptyState", errorMessage)
