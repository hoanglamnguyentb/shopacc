@model string
@{
    var showTitle = ViewData["ShowTitle"] as bool? ?? true;
}

<!-- Menu tài khoản -->
@if (showTitle)
{
    <p class="sidebar-section-title c-mb-16">Menu tài khoản</p>
}

<a href="/thong-tin"
   class="flex items-center gap-3 p-2 px-3 rounded-md hover:bg-zinc-100 cursor-pointer @(Model == "thong-tin" ? "bg-zinc-100 font-semibold" : "")">
    <i class="bi bi-person-circle"></i>Hồ sơ
</a>

<a href="/thong-bao"
   class="flex items-center gap-3 p-2 px-3 rounded-md hover:bg-zinc-100 cursor-pointer @(Model == "thong-bao" ? "bg-zinc-100 font-semibold" : "")">
    <i class="bi bi-bell"></i>Thông báo
</a>

<a href="/doi-mat-khau"
   class="flex items-center gap-3 p-2 px-3 rounded-md hover:bg-zinc-100 cursor-pointer @(Model == "doi-mat-khau" ? "bg-zinc-100 font-semibold" : "")">
    <i class="bi bi-shield-lock"></i>Đổi mật khẩu
</a>

<div class="h-[1px] bg-gray-300 my-2"></div>

<!-- Menu giao dịch -->
@if (showTitle)
{
    <p class="sidebar-section-title c-mb-16">Menu giao dịch</p>
}

<a href="/lich-su-giao-dich"
   class="flex items-center gap-3 p-2 px-3 rounded-md hover:bg-zinc-100 cursor-pointer @(Model == "lich-su-giao-dich" ? "bg-zinc-100 font-semibold" : "")">
    <i class="bi bi-clock-history"></i>Lịch sử giao dịch
</a>

<a href="/tai-khoan-da-mua"
   class="flex items-center gap-3 p-2 px-3 rounded-md hover:bg-zinc-100 cursor-pointer @(Model == "tai-khoan-da-mua" ? "bg-zinc-100 font-semibold" : "")">
    <i class="bi bi-cart-check"></i>Tài khoản đã mua
</a>

<a href="/lich-su-nap-tien"
   class="flex items-center gap-3 p-2 px-3 rounded-md hover:bg-zinc-100 cursor-pointer @(Model == "lich-su-nap-tien" ? "bg-zinc-100 font-semibold" : "")">
    <i class="bi bi-credit-card-2-front"></i>Lịch sử nạp tiền
</a>

<div class="h-[1px] bg-gray-300 my-2"></div>

<!-- Menu nạp -->
@if (showTitle)
{
    <p class="sidebar-section-title c-mb-16">Menu nạp</p>
}

<a href="/home/recharge"
   class="flex items-center gap-3 p-2 px-3 rounded-md hover:bg-zinc-100 cursor-pointer">
    <i class="bi bi-wallet2"></i>Nạp tiền tài khoản
</a>

<div class="h-[1px] bg-gray-300 my-2"></div>

<!-- Đăng xuất -->
<a class="flex items-center gap-3 p-2 px-3 rounded-md hover:bg-zinc-100 cursor-pointer"
   href="/Account/LogOff">
    <i class="bi bi-box-arrow-right"></i>Đăng xuất
</a>
