     <!--Start of Tawk.to Script-->
     @if (currentUser != null)
     {
         <text>
             <script src="~/Scripts/jquery.signalR-2.4.1.min.js"></script>
             <script>
            $(function () {
                var userId = '@currentUser.Id';
                if (!userId) return;

                var connection = $.hubConnection();
                connection.qs = { "userId": userId };

                var notificationHub = connection.createHubProxy('notificationHub');

                notificationHub.on('receiveNotification', function (data) {
                    $('#rechargeModal').modal('hide');
                    Swal.fire({
                        icon: 'success',
                        title: 'Thông báo',
                        html: `<p style="line-height: 20px;">${data.message}</p><br>
                                <a href="${data.url}" class="btn btn-link c-mt-16 m-auto w-min">Xem chi tiết</a>`,
                        showConfirmButton: false,
                        timer: 3000
                    });
                    setTimeout(function () {
                        location.reload();
                    }, 3000);
                });

                connection.start().done(function () {
                    console.log("✅ Kết nối NotificationHub thành công");
                }).fail(function (err) {
                    console.error("❌ Không kết nối được SignalR:", err);
                });
            });
             </script>
         </text>
     }

