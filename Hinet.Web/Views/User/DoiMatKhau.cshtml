@using CommonHelper.Number;
@{
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
}
<div class="container">
    <ul class="breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
        </li>
        <li class="breadcrumb-item">
            <a href="#" class="breadcrumb-link">Đổi mật khẩu</a>
        </li>
    </ul>
    <hr />
</div>

<div class="container mt-10">
    <div class="row bg-white rounded-md p-4 shadow-sm">
        <div class="c-history-left media-web">
            <div class="sidebar">
                @Html.Partial("_SidebarUser", "doi-mat-khau")
            </div>
        </div>
        <div class="c-ml-16 c-ml-lg-0 c-history-right c_history-right">
            <div class="mb-2">
                <div class="flex items-center gap-2">
                    <h2 class="text-zinc-800 font-medium uppercase text-xl">Đổi mật khẩu</h2>
                </div>
            </div>
            <div class="form-global-error text-danger c-mt-8 c-px-16"></div>
            <div class="form-global-success text-success c-mt-8 c-px-16"></div>
            <div class="brs-12 c-py-16 c-mb-16">
                @using (Ajax.BeginForm(
                    "ChangePassword",
                    "Account",
                    null,
                    new AjaxOptions
                    {
                        HttpMethod = "POST",
                        OnSuccess = "onChangePasswordSuccess",
                        OnFailure = "onChangePasswordFailure"
                    },
                    new { id = "form-changePassword", @class = "ajax-form" }
                ))
                {
                    @Html.AntiForgeryToken()

                    <div class="input-group">
                        <span class="form-label">Mật khẩu cũ</span>
                        <div class="toggle-password">
                            <input class="password-old" type="password" name="old_password" placeholder="Vui lòng nhập mật khẩu cũ" />
                        </div>
                        <span class="text-error c-mt-4"></span>
                    </div>

                    <div class="input-group">
                        <span class="form-label">Mật khẩu mới</span>
                        <div class="toggle-password">
                            <input class="password" name="password" type="password" placeholder="Vui lòng nhập mật khẩu mới" />
                        </div>
                        <span class="text-error c-mt-4"></span>
                    </div>

                    <div class="input-group">
                        <span class="form-label">Xác nhận</span>
                        <div class="toggle-password">
                            <input class="password-confirm" type="password" name="password_confirmation" placeholder="Vui lòng xác nhận mật khẩu mới" />
                        </div>
                        <span class="text-error c-mt-4"></span>
                    </div>

                    <div class="button-password d-flex justify-content-end">
                        <button class="btn primary btn-data" type="submit" style="position: relative">
                            Đổi mật khẩu
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script>
    function clearMessages() {
        $('.text-error').text('');
        $('.form-global-error').text('');
        $('.form-global-success').text('');
    }

    function onChangePasswordSuccess(response) {
        clearMessages();

        if (response.success) {
            $('.form-global-success').text(response.message);
            $('#form-changePassword')[0].reset();
        } else {
            if (response.errors) {
                for (const key in response.errors) {
                    const inputGroup = $(`input[name="${key}"]`).closest('.input-group');
                    inputGroup.find('.text-error').text(response.errors[key]);
                }
            } else {
                $('.form-global-error').text(response.message);
            }
        }
    }

    function onChangePasswordFailure(xhr) {
        clearMessages();
        $('.form-global-error').text("Có lỗi xảy ra. Vui lòng thử lại!");
    }
</script>
