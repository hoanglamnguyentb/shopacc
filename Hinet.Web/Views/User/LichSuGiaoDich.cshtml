@using CommonHelper.Number;
@model Hinet.Service.Common.PageListResultBO<Hinet.Service.GiaoDichService.Dto.GiaoDichDto>
@{
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
    var showTaiKhoan = ViewData["ShowTaiKhoan"] as bool? ?? false;
}

<div class="container c-container-side c-mb-4 c-mb-lg-0">
    <ul class="breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
        </li>
        <li class="breadcrumb-item">
            <a href="#" class="breadcrumb-link">Lịch sử giao dịch</a>
        </li>
    </ul>
    <hr />

    <div class="row">
        <div class="c-history-left media-web">
            <div class="sidebar">
                @Html.Partial("_SidebarUser", "lich-su-giao-dich")
            </div>
        </div>
        <div class="c-ml-16 c-ml-lg-0 c-history-right c_history-right">
            <div class="section-header d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center flex-wrap c-py-16" 
                 style="gap: 8px;">
                <h1 class="fw-700 fz-20 lh-28 c-my-0 mb-3 mb-lg-0">Lịch sử giao dịch</h1>
                @using (Ajax.BeginForm(
                    "LoadLichSuGiaoDich",       // Action
                    "User",                     // Controller
                    new AjaxOptions
                    {
                        HttpMethod = "GET",     // hoặc POST tùy bạn
                        UpdateTargetId = "giaodich-list-container", // nơi cập nhật nội dung
                        InsertionMode = InsertionMode.Replace
                    },
                    new { id = "form-filter", @class = "d-flex align-items-center", style = "gap:4px" }
                    ))
                {
                    <input type="date" class="form-control" id="TuNgayFilter" name="TuNgayFilter" placeholder="Từ ngày" />
                    <input type="date" class="form-control" id="DenNgayFilter" name="DenNgayFilter" placeholder="đến ngày" />
                    <button type="submit" class="btn ghost flex-shrink-0">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                }
            </div>
            <div id="giaodich-list-container" class="table-responsive">
                @Html.Partial("_LichSuGiaoDichList", Model ,new ViewDataDictionary {
                                        { "ShowTaiKhoan", showTaiKhoan }
                                    })
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>

<script>
    function loadPage(page) {
        var formData = $("#form-filter").serializeArray();

        var data = { page: page };
        $.each(formData, function (i, field) {
            data[field.name] = field.value;
        });

        $.ajax({
            url: "/User/LoadLichSuGiaoDich",
            type: "GET",
            data: data,
            success: function (res) {
                $("#giaodich-list-container").html(res);
                $('html, body').animate({ scrollTop: 0 }, 200);
            }
        });
    }

    // Phân trang
    $(document).on("click", ".js-change-page", function (e) {
        e.preventDefault();
        var page = $(this).data("page");
        if (!page || $(this).parent().hasClass("disabled") || $(this).parent().hasClass("active")) return;
        loadPage(page);
    });
</script>