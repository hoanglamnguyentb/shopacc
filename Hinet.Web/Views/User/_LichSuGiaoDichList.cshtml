@using CommonHelper.Number;
@using Hinet.Service.Constant;
@model Hinet.Service.Common.PageListResultBO<Hinet.Service.GiaoDichService.Dto.GiaoDichDto>
@{
    var loaiGiaoDich = ViewData["LoaiGiaoDich"] ?? null;
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
    var index = (Model.CurrentPage - 1) * 10;
}

<table class="table table-striped table-hover align-middle table-bordered">
    <thead>
        <tr>
            <th scope="col" class="w-0">#</th>
            <th scope="col">Ngày</th>
            @if (loaiGiaoDich == LoaiGiaoDichConstant.MUAACC)
            {
                <th scope="col">Tài khoản</th>
            }
            @if (loaiGiaoDich == null)
            {
                <th scope="col">Loại giao dịch</th>
            }
            <th scope="col">Nội dung</th>
            <th scope="col" class="text-center">Số tiền</th>
            <th scope="col" class="text-center">Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ListItem != null && Model.ListItem.Any())
        {
            foreach (var item in Model.ListItem)
            {
                index++;
                <tr>
                    <td class="w-0">@index</td>
                    <td>
                        @item.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm")
                        @*@if (item.LoaiGiaoDich == LoaiGiaoDichConstant.NAPTOPUP)
                        {
                            <span class="badge badge-info"><i class="bi bi-wallet2"></i> Nạp topup</span>
                        }*@
                    </td>
                    @if (loaiGiaoDich == LoaiGiaoDichConstant.MUAACC)
                    {
                        <td><a href="/acc/@item.TaiKhoanTxt" class="text-blue-500" target="_blank">#@item.TaiKhoanTxt</a></td>
                    }
                    @if (loaiGiaoDich == null)
                    {
                        <td>@item.LoaiGiaoDichTxt</td>
                    }
                <td>
                    @if (loaiGiaoDich == LoaiGiaoDichConstant.NAPTOPUP)
                    {
                        <a href="/don-hang/@item.DoiTuongId" class="text-blue-500" target="_blank">@item.NoiDungChuyenKhoan</a>
                    }
                    else
                    {
                        <div>@item.NoiDungChuyenKhoan</div>
                    }
                </td>
                <td class="text-right @(item.SoTien > 0 ? "text-success" : "text-danger")">
                    @if (item.TrangThai == TrangThaiGiaoDichConstant.KHOITAO)
                    {
                        <span class="text-gray-500">@NumberHelper.FormatMoneyVN(item.SoTien)</span>
                    }
                    else
                    {
                        if (item.LoaiGiaoDich == LoaiGiaoDichConstant.NAPTHUONG)
                        {
                            @(item.SoTien > 0 ? "+" : "") @NumberHelper.FormatMoneyVN(item.SoTien)
                        }
                        else
                        {
                            @NumberHelper.FormatMoneyVN(item.SoTien)
                        }
                    }
                </td>
                    <td class="text-center">
                        @if (item.TrangThai == "Thành công")
                        {
                            <span class="badge bg-success">Thành công</span>
                        }
                        else
                        {
                            @Html.Raw(item.TrangThaiHTML)
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center p-4">
                    @Html.Partial("_EmptyState", "Hiện tại bạn chưa có giao dịch nào.")
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Render pagination -->
@Html.Partial("~/Views/Shared/Components/_PaginationAjax.cshtml", Model)

@if (loaiGiaoDich == LoaiGiaoDichConstant.NAPTHUONG)
{
    <text>
        <script>
            $(document).on('click', '.toggle-password', function () {
                const $btn = $(this);
                const $input = $btn.siblings('.password-field');

                if ($input.attr('type') === 'password') {
                    $input.attr('type', 'text');
                    $btn.find('i').removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    $input.attr('type', 'password');
                    $btn.find('i').removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });
        </script>
    </text>
}