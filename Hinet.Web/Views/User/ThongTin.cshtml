@using CommonHelper.Number;
@{ 
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
}

<div class="container">
    <ul class="breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
        </li>
        <li class="breadcrumb-item">
            <a href="#" class="breadcrumb-link">Thông tin tài khoản</a>
        </li>
    </ul>
    <hr />
</div>

<div class="container mt-10">
    <div class="row bg-white rounded-md p-4 shadow-sm">
        <div class="c-history-left media-web">
            <div class="sidebar">
                @Html.Partial("_SidebarUser", "thong-tin")
            </div>
        </div>
        <div class="c-ml-16 c-ml-lg-0 c-history-right c_history-right">
            <div class="mb-2">
                <div class="flex items-center gap-2">
                    <h2 class="text-zinc-800 font-medium uppercase text-xl">Thông tin tài khoản</h2>
                </div>
            </div>
            <div class="brs-12 c-p-16 c-mb-16">
                <div class="history-detail-attr c-mb-8 d-flex justify-content-between align-items-center">
                    <p class="mb-0">ID của bạn</p>
                    <div class="fw-600" id="info_id">@currentUser.Id</div>
                </div>
                <div class="history-detail-attr c-mb-8 d-flex justify-content-between align-items-center">
                    <p class="mb-0">Tên tài khoản</p>
                    <div class="fw-600" id="info_name">@(currentUser.FullName ?? currentUser.UserName)</div>
                </div>
                <div class="history-detail-attr c-mb-8 d-flex justify-content-between align-items-cente">
                    <p class="mb-0">Số dư tài khoản</p>
                    <div class="detail-primary fw-600" id="info_balance">@(NumberHelper.FormatMoneyVN(currentUser.Balance))</div>
                </div>
            </div>
        </div>
    </div>
</div>