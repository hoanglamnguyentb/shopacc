@using CommonHelper.Number;
@model Hinet.Service.Common.PageListResultBO<Hinet.Service.GiaoDichService.Dto.GiaoDichDto>
@{
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
}
<div class="container">
    <ul class="breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
        </li>
        <li class="breadcrumb-item">
            <a href="#" class="breadcrumb-link">Tài khoản đã mua</a>
        </li>
    </ul>
    <hr />
</div>
<div class="container mt-10">
    <div class="row bg-white rounded-md p-4 shadow-sm">
        <div class="c-history-left media-web">
            <div class="sidebar">
                @Html.Partial("_SidebarUser", "tai-khoan-da-mua")
            </div>
        </div>
        <div class="c-ml-16 c-ml-lg-0 c-history-right c_history-right">
            <div class="mb-2">
                <div class="flex items-center gap-2 justify-content-between">
                    <h2 class="text-zinc-800 font-medium uppercase text-xl">Tài khoản đã mua</h2>
                    @using (Ajax.BeginForm(
                        "LoadLichSuGiaoDich",       // Action
                        "User",                     // Controller
                        new AjaxOptions
                        {
                            HttpMethod = "GET",     // hoặc POST tùy bạn
                            UpdateTargetId = "giaodich-list-container", // nơi cập nhật nội dung
                            InsertionMode = InsertionMode.Replace
                        },
                        new { id = "form-filter", @class = "d-flex align-items-center", style = "gap:4px" }
                        ))
                    {
                        <input type="hidden" id="trangThaiGiaoDichFilter" name="LoaiGiaoDichFilter" value="@Hinet.Service.Constant.LoaiGiaoDichConstant.MUAACC" />
                        <input type="hidden" id="TrangThaiFilter" name="TrangThaiFilter" value="@Hinet.Service.Constant.TrangThaiGiaoDichConstant.DATHANHTOAN" />
                        <input type="date" class="form-control form-control-sm" id="TuNgayFilter" name="TuNgayFilter" placeholder="Từ ngày" />
                        <input type="date" class="form-control form-control-sm" id="DenNgayFilter" name="DenNgayFilter" placeholder="đến ngày" />
                        <button type="submit" class="btn ghost flex-shrink-0">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                    }
                </div>
            </div>
            <div id="giaodich-list-container">
                @Html.Partial("_LichSuGiaoDichList")
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal__buyacount loadModal__acount modal-big"
     id="chiTietModal"
     style="display: none"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-custom"
         role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-center text-uppercase">
                    Chi tiết tài khoản
                </h4>
                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body"
                 style="font-family: helvetica, arial, sans-serif">
            </div>
            <div class="modal-footer c-p-8 text-right">
                <button class="btn btn-light"
                        type="button"
                        data-dismiss="modal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>

<script>
    function loadPage(page) {
        var formData = $("#form-filter").serializeArray();

        var data = { page: page };
        $.each(formData, function (i, field) {
            data[field.name] = field.value;
        });

        $.ajax({
            url: "/User/LoadLichSuGiaoDich",
            type: "GET",
            data: data,
            success: function (res) {
                $("#giaodich-list-container").html(res);
                $('html, body').animate({ scrollTop: 0 }, 200);
            }
        });
    }

    // Phân trang
    $(document).on("click", ".js-change-page", function (e) {
        e.preventDefault();
        var page = $(this).data("page");
        if (!page || $(this).parent().hasClass("disabled") || $(this).parent().hasClass("active")) return;
        loadPage(page);
    });
</script>

<script>
    $(document).on('click', '.js-view-detail', function (e) {
        e.preventDefault();
        var url = $(this).data('url');
        $('#chiTietModal').modal('show');

        $('#chiTietModal .modal-body').html(`
            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden"></span>
                </div>
                <div class="mt-2">Đang tải dữ liệu...</div>
            </div>
        `);

        $.ajax({
            url: url,
            type: 'GET',
            success: function (html) {
                $('#chiTietModal .modal-body').html(html);
            },
            error: function () {
                $('#chiTietModal .modal-body').html('<div class="text-danger p-3 text-center">Không thể tải chi tiết. Vui lòng thử lại.</div>');
            }
        });
    });
</script>