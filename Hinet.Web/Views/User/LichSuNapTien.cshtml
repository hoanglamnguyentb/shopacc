@using CommonHelper.Number;
@model Hinet.Service.Common.PageListResultBO<Hinet.Service.GiaoDichService.Dto.GiaoDichDto>
@{
    var currentUser = (Hinet.Service.AppUserService.Dto.UserDto)SessionManager.GetUserInfo();
}

<div class="container">
    <ul class="breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
        </li>
        <li class="breadcrumb-item">
            <a href="#" class="breadcrumb-link">Lịch sử biến động số dư</a>
        </li>
    </ul>
    <hr />
</div>

<div class="container mt-10">
    <div class="row bg-white rounded-md p-4 shadow-sm"">
        <div class="c-history-left media-web">
            <div class="sidebar">
                @Html.Partial("_SidebarUser", "lich-su-nap-tien")
            </div>
        </div>
        <div class="c-ml-16 c-ml-lg-0 c-history-right c_history-right">
            <div class="mb-2">
                <div class="flex items-center gap-2 justify-content-between">
                    <h2 class="text-zinc-800 font-medium uppercase text-xl">Lịch sử biến động số dư</h2>
                    @using (Ajax.BeginForm(
                        "LoadLichSuGiaoDich",
                        "User",
                        new AjaxOptions
                        {
                            HttpMethod = "GET", 
                            UpdateTargetId = "giaodich-list-container",
                            InsertionMode = InsertionMode.Replace
                        },
                        new { id = "form-filter", @class = "d-flex align-items-center", style = "gap:4px" }
                        ))
                    {
                        <input type="hidden" id="LoaiGiaoDichFilter" name="LoaiGiaoDichFilter" value="@Hinet.Service.Constant.LoaiGiaoDichConstant.NAPTHUONG" />
                        <input type="date" class="form-control form-control-sm" id="TuNgayFilter" name="TuNgayFilter" placeholder="Từ ngày" />
                        <input type="date" class="form-control form-control-sm" id="DenNgayFilter" name="DenNgayFilter" placeholder="đến ngày" />
                        <button type="submit" class="btn ghost flex-shrink-0">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                    }
                </div>
            </div>
            <div id="giaodich-list-container">
                @Html.Partial("_LichSuGiaoDichList")
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>

<script>
    function loadPage(page) {
        var formData = $("#form-filter").serializeArray();

        var data = { page: page };
        $.each(formData, function (i, field) {
            data[field.name] = field.value;
        });

        $.ajax({
            url: "/User/LoadLichSuGiaoDich",
            type: "GET",
            data: data,
            success: function (res) {
                $("#giaodich-list-container").html(res);
                $('html, body').animate({ scrollTop: 0 }, 200);
            }
        });
    }

    // Phân trang
    $(document).on("click", ".js-change-page", function (e) {
        e.preventDefault();
        var page = $(this).data("page");
        if (!page || $(this).parent().hasClass("disabled") || $(this).parent().hasClass("active")) return;
        loadPage(page);
    });
</script>