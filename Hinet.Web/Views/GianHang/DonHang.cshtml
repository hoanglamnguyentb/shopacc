@using CommonHelper.Number;
@model Hinet.Service.DonHangService.Dto.DonHangDto
@{
    var config = ViewBag.SiteConfig as Hinet.Model.Entities.SiteConfig;
}

<div class="container c-container" id="account-category">
    <ul class="breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
        </li>
        <li class="breadcrumb-item">
            <a href="javascript:void(0)" class="breadcrumb-link">Đơn hàng</a>
        </li>
    </ul>
    <hr />

    <div class="container mx-auto my-10">
        <div class="bg-white rounded-md border">
            <div class="flex p-4 border-b justify-between">
                <div class="text-lg">Hoá đơn #@Model.Id</div>
                <div>@Html.Raw(Model.TrangThaiHTML)</div>
            </div>
            <div class="p-4">
                <div class="flex flex-col gap-4 text-gray-600 ">
                    <div class="flex justify-between">
                        <div>Trò chơi</div>
                        <div class="text-gray-900">@Model.GianHang.Name</div>
                    </div>
                    <div class="flex justify-between">
                        <div>Sản phẩm</div>
                        <div class="text-gray-900">@Model.VatPham.Name</div>
                    </div>
                    <div class="flex justify-between">
                        <div>Giá</div>
                        <div class="text-gray-900">@NumberHelper.FormatMoneyVN(@Model.VatPham.GiaGoc)</div>
                    </div>
                    <div class="flex justify-between">
                        <div>Số lượng</div>
                        <div class="text-gray-900">x@(Model.SoLuong)</div>
                    </div>
                    @if (Model.ListGTTT != null && Model.ListGTTT.Count > 0)
                    {
                        foreach (var item in Model.ListGTTT)
                        {
                            <div class="h-[1px] bg-zinc-200"></div>
                            <div class="flex justify-between">
                                <div>@item.ThuocTinhTxt</div>
                                <div class="text-gray-900">@item.GiaTriTxt</div>
                            </div>
                        }
                    }
                    @if (Model.MaGiamGia != null)
                    {
                        <div class="h-[1px] bg-zinc-200"></div>
                        <div class="flex justify-between">
                            <div>Mã giảm giá (@Model.MaGiamGia.Code)</div>
                            <div class="text-gray-900 text-red-500">-@NumberHelper.FormatMoneyVN(Model.GiaGoc - Model.GiaKhuyenMai)</div>
                        </div>
                    }
                    <div class="h-[1px] bg-zinc-200"></div>
                    <div class="flex justify-between">
                        <div>Tổng tiền</div>
                        <div class="text-gray-900 font-semibold">@NumberHelper.FormatMoneyVN(Model.GiaKhuyenMai)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-md border mt-4">
            <div class="flex p-4 border-b justify-between">
                <div class="text-lg">Thông tin thanh toán</div>
            </div>
            <div class="p-4 flex flex-col md:flex-row">
                <table class="table-auto border-collapse border border-gray-300 w-full">
                    <tbody>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">Ngân hàng</td>
                            <td class="border border-gray-300 px-4 py-2">
                                @config.BankCode
                            </td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">Số tài khoản:</td>
                            <td class="border border-gray-300 px-4 py-2">
                                @config.AccountNumber
                            </td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">Chủ tài khoản:</td>
                            <td class="border border-gray-300 px-4 py-2">
                                @config.AccountName
                            </td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">Số tiền:</td>
                            <td class="border border-gray-300 px-4 py-2 font-semibold">
                                @NumberHelper.FormatMoneyVN(Model.GiaKhuyenMai)
                            </td>
                        </tr>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">Nội dung thanh toán:</td>
                            <td class="border border-gray-300 px-4 py-2 font-semibold">@Model.MaGiaoDich</td>
                        </tr>
                    </tbody>
                </table>
                <div class="p-2 border border-gray-300">
                    <img src="@Model.QrUrl" alt="" class=" md:w-60 w-full">
                </div>
            </div>
            <div class="p-4 flex flex-col md:flex-row gap-2 justify-content-end">
                <button type="button" class="bg-red-500 p-2 px-3 rounded-lg mt-4 text-white text-base" id="btn-huybo" onclick="huyDonHang(this)">
                    Hủy bỏ
                </button>
                <button type="submit" class="bg-blue-500 p-2 px-3 rounded-lg mt-4 text-white text-base" id="btn-thanhtoan">
                    Thanh toán bằng tài khoản
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function huyDonHang(el) {
        var donHangId = @Model.Id;//Mã đơn hàng

        $.ajax({
            url: '/GiaoDich/HuyGiaoDich?=donHangId' + encodeURIComponent(donHangId),
            type: 'DELETE',
            success: function (res) {
                if (res.Success) {
                    console.log("Hủy giao dịch thành công:", maGiaoDich);
                    window.history.back();
                } else {
                    console.log("Có lỗi khi hủy giao dịch:", res.Message);
                }
            },
            error: function () {
                console.log("Lỗi kết nối khi huỷ giao dịch");
            }
        });
    }

    $(document).ready(function () {
        var tenDonHang = '@Model.MaGiaoDich';
        var tongTien = @Model.TongTien;
        $('#btn-thanhtoan').on('click', function () {
            Swal.fire({
                title: 'Xác nhận thanh toán',
                html: 'Bạn có chắc muốn thanh toán đơn hàng <b>#' + tenDonHang + '</b> với giá trị <b>' + tongTien.toLocaleString('vi-VN') + ' đ</b> không?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
            }).then((result) => {
                if (result.isConfirmed) {
                    thanhToanDonHang();
                }
            });
        });
    });

    function thanhToanDonHang() {
        var donHangId = @Model.Id;

        $.ajax({
            url: '/GiaoDich/ThanhToanTaiKhoan',
            type: 'POST',
            data: { donHangId: donHangId },
            success: function (res) {
                if (res.Success) {
                    Swal.fire({
                        title: 'Thành công!',
                        text: 'Đơn hàng đã được thanh toán thành công.',
                        icon: 'success',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        // Chuyển hướng sau khi thanh toán thành công
                        window.location.href = '/order/' + donHangId;
                    });
                } else {
                    Swal.fire({
                        title: 'Lỗi!',
                        text: res.Message || 'Không thể thanh toán đơn hàng.',
                        icon: 'error',
                        confirmButtonText: 'Đóng'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    title: 'Lỗi kết nối',
                    text: 'Không thể kết nối đến máy chủ.',
                    icon: 'error',
                    confirmButtonText: 'Đóng'
                });
            }
        });
    }
</script>